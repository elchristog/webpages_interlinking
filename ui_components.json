    {
      "id": "ui-data-comparison",
      "name": "Data Comparison Dashboard (Apple Bento Dark)",
      "allowed_presets": [
        "ui-preset--midnight"
      ],
      "prompt": "SECCIÓN DATA COMPARISON (ui-data-comparison): Dashboard Bento de tendencias en tono oscuro (#18181b) con tarjetas de leyenda (#27272a) y gráfico centrado. Úsala para comparar métricas o estadísticas.\n<section class=\"ui-data-comparison-container py-20 md:py-28 bg-[#0a0a0a] text-white overflow-hidden\">\n  <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n    <p class=\"comparison-intro text-lg md:text-2xl text-gray-200 max-w-4xl mx-auto mb-14 text-center leading-relaxed\">\n      Análisis de mercado: <span class=\"bg-gradient-to-r from-orange-400 to-amber-500 bg-clip-text text-transparent font-semibold\">Explosión de demanda laboral</span>\n    </p>\n    <div class=\"comparison-dashboard bg-[#18181b] rounded-[2.5rem] md:rounded-[3rem] p-6 md:p-12 border border-white/10 shadow-2xl\">\n      <div class=\"legend-cards grid grid-cols-1 md:grid-cols-2 gap-6 mb-10\">\n        <div class=\"legend-card bg-[#27272a] p-6 rounded-2xl border border-white/10 shadow-lg\">\n          <div class=\"legend-header flex items-center gap-3 mb-2\"><span class=\"legend-marker w-4 h-4 rounded-full bg-blue-500\"></span><span class=\"legend-name text-xl font-bold text-white\">Vacantes Disponibles</span></div>\n          <span class=\"legend-label text-sm text-gray-300 ml-7 block\">Demanda en Aumento</span>\n        </div>\n        <div class=\"legend-card bg-[#27272a] p-6 rounded-2xl border border-white/10 shadow-lg\">\n          <div class=\"legend-header flex items-center gap-3 mb-2\"><span class=\"legend-marker w-4 h-4 rounded-full bg-red-500\"></span><span class=\"legend-name text-xl font-bold text-white\">Procesamiento de Visas</span></div>\n          <span class=\"legend-label text-sm text-gray-300 ml-7 block\">Capacidad Limitada</span>\n        </div>\n      </div>\n      <div class=\"chart-area bg-[#09090b] p-6 md:p-10 rounded-2xl border border-white/10 shadow-inner text-center\">\n        <h3 class=\"chart-title text-2xl md:text-4xl font-bold text-white mb-4 tracking-tight\">Tendencia de Empleo y Patrocinio</h3>\n        <p class=\"text-base md:text-xl text-gray-300 max-w-3xl mx-auto mb-8 leading-relaxed\">La demanda actual supera la oferta nacional en más de un 300%.</p>\n        <div class=\"chart-wrapper relative w-full overflow-hidden rounded-xl border border-white/10 bg-black/40 max-h-[480px] shadow-2xl\">\n          <img src=\"/imagenes_proyecto/ofertas-de-empleo-y-salarios-promedios-para-enfermeras-extranjeras-en-miami-y-tampa-florida-3.webp\" alt=\"Gráfico de tendencias\" class=\"w-full h-full object-cover object-center\">\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
    },
