---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const sections = [
  {
    title: "Evaluación",
    paragraph:
      "Analizamos tus títulos universitarios y créditos clínicos para cumplir con los requisitos del State Board. Obtén una hoja de ruta clara para validar tu título y alcanzar el máximo rango salarial.",
  },
  {
    title: "Preparación NCLEX",
    paragraph:
      "Preparación intensiva con simuladores NGN adaptativos para aprobar el examen NCLEX-RN al primer intento. Domina los temas clave del examen de enfermería con recursos adaptados y mentoría personalizada.",
  },
  {
    title: "Trámite Visado",
    paragraph:
      "Acompañamiento legal continuo para la tramitación de petición I-140 y residencia permanente EB-3. Garantizamos asesoría legal en cada etapa del proceso de inmigración para ti y tu familia.",
  },
  {
    title: "Patrocinio Hospitalario",
    paragraph:
      "Conexión directa con hospitales líderes y agencias acreditadas en Estados Unidos. Accede a posiciones con bonos de contratación y excelentes beneficios médicos.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-2">
    <div class="px-8 pt-24 bg-orange">
      <Text
        tag="h2"
        variant="displayLG"
        class="font-semibold tracking-tight text-white text-balance"
        >Información especializada sobre salarios por especialidad y turnos para enfermeras internacionales.</Text
      >
      <div class="flex flex-col mt-12">
        {
          sections.map((section, index) => (
            <div class="sticky top-0 z-10 py-8 border-t border-dashed border-white/20 grid grid-cols-1 gap-12 lg:gap-0 lg:grid-cols-5 bg-orange">
              <Text
                tag="span"
                variant="display2XL"
                class="font-bold tracking-tight text-white"
              >
                {String(index + 1).padStart(2, "0")}
              </Text>

              <div class="flex flex-col border-dashed lg:col-span-4 gap-24 lg:pl-12 lg:border-l lg:border-white/20">
                <Text
                  tag="h3"
                  variant="display2XL"
                  class="font-bold tracking-tight text-white"
                >
                  {section.title}
                </Text>
                <Text
                  tag="p"
                  variant="textLG"
                  class="max-w-xl font-semibold text-white"
                >
                  {section.paragraph}
                </Text>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
