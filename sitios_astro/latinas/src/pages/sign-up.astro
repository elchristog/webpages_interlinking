---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ArrowRight from "@/components/fundations/icons/ArrowRight.astro";
---

<BaseLayout hideNav={true} hideFooter={true}>
  <section class="overflow-hidden">
    <Wrapper variant="standard" class="py-4">
      <div
        class="p-10 rounded-4xl bg-base-900 lg:px-20 lg:h-[calc(100svh-2rem)] flex flex-col justify-center"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-end mt-auto">
          <div>
            <div>
              <a
                href="/"
                class="text-base-400 text-xs font-display hover:text-white"
                >Go back</a
              >
              <Text
                tag="h1"
                variant="displaySM"
                class="font-display text-white md:w-1/2 mt-8 text-balance"
              >
                Join Us. It’s only mildly commitment-heavy.
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="text-base-200 pl-8 mt-4 text-balance"
              >
                Create an account to unlock content, features, and the
                occasional email you might actually read. It’s free—unless you
                start clicking fancy buttons.
              </Text>
              <Button
                isLink
                href="/"
                size="sm"
                variant="orange"
                class="mt-8 w-fit"
              >
                Go back gome
              </Button>
            </div>
          </div>

          <form action="#" method="POST" class="mt-2">
            <div class="flex flex-col gap-y-2">
              <!-- Email -->
              <div>
                <label for="email" class="text-sm font-medium text-base-500"
                  >Email</label
                >
                <div class="mt-1">
                  <input
                    type="email"
                    name="email"
                    id="email"
                    autocomplete="email"
                    required
                    aria-required="true"
                    aria-describedby="email-error"
                    class="block w-full h-20 px-4 py-2 font-display text-3xl text-white border border-transparent appearance-none bg-base-800 rounded-3xl duration-300 placeholder-base-300 focus:bg-transparent focus:outline-none focus:ring-pink-500 focus:ring-offset-2 focus:ring-2 focus:ring-offset-base-500"
                  />
                  <span id="email-error" class="hidden text-sm text-red-600">
                    Please enter a valid email address.
                  </span>
                </div>
              </div>

              <!-- Password -->
              <div>
                <label for="password" class="text-sm font-medium text-base-500"
                  >Password</label
                >
                <div class="mt-1">
                  <input
                    type="password"
                    name="password"
                    id="password"
                    autocomplete="new-password"
                    required
                    aria-required="true"
                    aria-describedby="password-error"
                    class="block w-full h-20 px-4 py-2 font-display text-3xl text-white border border-transparent appearance-none bg-base-800 rounded-3xl duration-300 placeholder-base-300 focus:bg-transparent focus:outline-none focus:ring-pink-500 focus:ring-offset-2 focus:ring-2 focus:ring-offset-base-500"
                  />
                  <span id="password-error" class="hidden text-sm text-red-600">
                    Please enter a secure password.
                  </span>
                </div>
              </div>

              <!-- Confirm Password -->
              <div>
                <label
                  for="confirm-password"
                  class="text-sm font-medium text-base-500"
                  >Confirm Password</label
                >
                <div class="mt-1">
                  <input
                    type="password"
                    name="confirm-password"
                    id="confirm-password"
                    autocomplete="new-password"
                    required
                    aria-required="true"
                    aria-describedby="confirm-password-error"
                    class="block w-full h-20 px-4 py-2 font-display text-3xl text-white border border-transparent appearance-none bg-base-800 rounded-3xl duration-300 placeholder-base-300 focus:bg-transparent focus:outline-none focus:ring-pink-500 focus:ring-offset-2 focus:ring-2 focus:ring-offset-base-500"
                  />
                  <span
                    id="confirm-password-error"
                    class="hidden text-sm text-red-600"
                  >
                    Passwords must match.
                  </span>
                </div>
              </div>
            </div>
            <p class="text-xs font-display text-white mt-2">
              Already have an account?
              <a
                href="/sign-in"
                class="font-medium text-pink-500 hover:text-base-500"
              >
                Asesoría
              </a>
            </p>
            <Button
              iconOnly
              type="submit"
              size="20"
              variant="pink"
              class="mt-8"
            >
              <ArrowRight slot="icon" size="xl" />
            </Button>
          </form>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
