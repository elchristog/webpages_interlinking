---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
const { url, title, pubDate, tags } = {
  url: "/blog/posts/" + Astro.props.post.id,
  tags: Astro.props.post.data.tags,
  title: Astro.props.post.data.title,
  pubDate: new Date(Astro.props.post.data.pubDate).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "2-digit",
  }),
};
// Calculate reading time
import readingTime from "reading-time";

const stats = readingTime(Astro.props.post.body);
---

<article class="relative p-8 group bg-base-100 rounded-4xl">
  <a href={url} title={title} class="absolute inset-0 z-10"> </a>
  <div class="flex flex-col justify-between h-full col-span-2">
    <div class="flex items-center pl-8 font-display gap-x-2 text-base-700">
      <span>
        {
          tags.map((tag) => {
            const formattedTag = tag.replace(/-/g, " ");
            return (
              <Text
                tag="p"
                variant="textXS"
                title={tag}
                aria-label={tag}
                class="capitalize "
              >
                {formattedTag}
              </Text>
            );
          })
        }
      </span>
      <span>·</span>
      <Text tag="p" variant="textXS">
        <time datetime={pubDate}>{pubDate}</time>
      </Text>
      <span>·</span>
      <Text tag="p" variant="textXS"> {stats.text}</Text>
    </div>
    <Text
      tag="h3"
      variant="textLG"
      class="mt-8 font-display uppercase text-base-900"
    >
      {title}
    </Text>
  </div>
</article>
