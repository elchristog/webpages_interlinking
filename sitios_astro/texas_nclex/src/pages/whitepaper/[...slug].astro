---
import { getCollection, render } from "astro:content";
import WhitepaperLayout from "../../layouts/WhitepaperLayout.astro";
export async function getStaticPaths() {
  const whitepaper = await getCollection("whitepaper");
  const paths = whitepaper.map((page) => {
    return {
      params: { slug: page.id },
      props: { page },

      trailingSlash: false,
    };
  });
  return paths;
}
const { page } = Astro.props;
const { Content } = await render(page);
---

<WhitepaperLayout frontmatter={page.data}>
  <Content />
</WhitepaperLayout>
