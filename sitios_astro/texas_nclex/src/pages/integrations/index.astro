---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import IntegrationCard from "@/components/integrations/IntegrationCard.astro";

// Content
import { getCollection } from "astro:content";
const allIntegrations = await getCollection("integrations");
---

<BaseLayout>
  <section>
    <Wrapper
      variant="standard"
      class="py-42 relative grid grid-cols-1 gap-y-12 lg:gap-y-24 md:grid-cols-4"
    >
      <div class="md:col-span-2">
        <Text tag="span" variant="textSM" class="text-white">
          Integrations
        </Text>
        <Text
          tag="h1"
          variant="displayXL"
          class="mt-12 text-white text-balance font-display"
        >
          Seamless Web3 Payments:
          <span class="text-base-400 block">
            Powering Transactions with Leading Integrations</span
          >
        </Text>
        <Text tag="p" variant="textBase" class="text-white mt-2 text-balance">
          Connect your decentralized platform with top-tier payment providers.
          Enable secure, fast, and global transactions with Recurly, Stripe,
          Chargebee, and more.
        </Text>
     
      </div>
      <ul
        class="grid grid-cols-1 gap-y-24 sm:grid-cols-2 md:grid-cols-4 md:col-span-full md:row-start-2"
      >
        {allIntegrations.map((post) => <IntegrationCard post={post} />)}
      </ul>
    </Wrapper>
  </section>
</BaseLayout>
