---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getCollection } from "astro:content";
const allPosts = await getCollection("posts");
// Tags
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
---

<BaseLayout>
  <section class="bg-gradient-up">
    <Wrapper
      variant="standard"
      class="grid grid-cols-1 py-42 gap-y-12 lg:gap-y-24 lg:grid-cols-4"
    >
      <div>
        <Text
          tag="h1"
          variant="displayMD"
          class="text-white text-balance font-display capitalize"
        >
          Find your tag
        </Text>
        <div class="mt-12 before:bg-white">
          <div
            class="relative px-4 before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px"
          >
            <Text tag="h4" variant="textLG" class="font-medium text-white"
              >All tags</Text
            >
          </div>
          <div class="flex flex-col gap-2 mt-4 ">
            {
              tags.map((tag) => (
                <Text
                  tag="a"
                  variant="textSM"
                  class="w-auto text-white capitalize hover:text-base-400"
                  href={`/tags/${tag}`}
                >
                  {tag}
                </Text>
              ))
            }
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
