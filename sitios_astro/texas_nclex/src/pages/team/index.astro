---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Cta from "@/components/jobs/Cta.astro";
import TeamCard from "@/components/team/TeamCard.astro";
// Content
import { getCollection } from "astro:content";
const allTeam = await getCollection("team");
---

<BaseLayout>
  <section>
    <Wrapper
      variant="standard"
      class="py-42 relative grid grid-cols-1 gap-y-12 lg:gap-y-24 md:grid-cols-4"
    >
      <div class="md:col-span-2">
        <Text tag="span" variant="textSM" class="text-white">Our team</Text>
        <Text
          tag="h1"
          variant="displayXL"
          class="mt-12 text-white text-balance font-display"
        >
          We are a super talented
          <span class="md:block text-base-400"> and creative team </span>
        </Text>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-2 md:col-span-full md:row-start-2 lg:grid-cols-4 gap-y-12 lg:gap-y-24"
      >
        {allTeam.map((post) => <TeamCard post={post} />)}
      </div>
    </Wrapper>
  </section>
  <Cta />
</BaseLayout>
