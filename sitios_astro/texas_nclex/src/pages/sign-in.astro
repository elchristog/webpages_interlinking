---
import SplashLayout from "@/layouts/SplashLayout.astro";
// Assets
import { Code } from "astro:components";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<SplashLayout>
  <section class="overflow-hidden relative">
    <Wrapper
      variant="standard"
      class="grid grid-cols-1 py-42 lg:py-0 md:grid-cols-4 items-center lg:h-svh"
    >
      <div class="relative flex flex-col">
        <Text
        tag="h1"
        variant="displayXL"
        class="mt-12 text-white text-balance font-display"
      >
        Sign in
      </Text>
      <Text tag="p" variant="textBase" class="text-white mt-2 text-balance"
        >Get in and manage your dashboard</Text
      >
      <form class="mt-12">
        <div class="flex flex-col gap-y-4">
          <div class="flex flex-col-reverse relative">
            <input
              id="email"
              name="email"
              type="text"
              placeholder="Your email"
              autocomplete="email"
              class="peer relative placeholder:duration-500 placeholder:absolute focus:placeholder:pt-10 tblock w-full px-3 py-3 border-l border-l-white border-transparent appearance-none text-white bg-base-900 focus:border-white focus:bg-base-950 focus:outline-none duration-300 focus:ring-white sm:text-sm placeholder-base-500 h-14 focus:placeholder:text-transparent z-10"
            />
            <label
              for="email"
              class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-red-500 after:content-['*'] z-0"
            >
              Email
            </label>
          </div>

          <div class="flex flex-col-reverse relative">
            <input
              id="password"
              name="password"
              type="password"
              placeholder="Type password here..."
              autocomplete="current-password"
              class="peer relative placeholder:duration-500 placeholder:absolute focus:placeholder:pt-10 tblock w-full px-3 py-3 border-l border-l-white border-transparent appearance-none text-white bg-base-900 focus:border-white focus:bg-base-950 focus:outline-none duration-300 focus:ring-white sm:text-sm placeholder-base-500 h-14 borde-white focus:placeholder:text-transparent"
              required
            />
            <label
              for="password"
              class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-red-500 after:content-['*'] z-0"
            >
              Password
            </label>
          </div>
          <div class="flex items-center justify-between pb-4">
            <div class="flex items-center gap-2">
              <input
                id="remember-me"
                name="remember-me"
                type="checkbox"
                class="text-accent-500 focus:ring-transparent outline outline-base-800 size-4 bg-base-900"
              />
              <label
                for="remember-me"
                class="font-medium text-sm block leading-tight ml-2 text-base-500"
              >
                Remember me
              </label>
            </div>
            <Text
              tag="a"
              href="/forms/"
              variant="textXS"
              class="font-medium hover:text-base-500 text-white"
            >
              Forgot your password?
            </Text>
          </div>

          <div class="flex flex-col gap-4">
            <Button
              size="base"
              variant="default"
              type="Button"
              class="w-auto justify-center"
            >
              Submit
            </Button>
            <Button
              size="base"
              variant="muted"
              type="Button"
              class="flex items-center justify-center gap-2 w-full"
            >
              <svg
                class="size-4"
                fill="none"
                height="18"
                viewBox="0 0 32 32"
                width="24"
                xmlns="http://www.w3.org/2000/svg"
                ><path
                  d="M30.0014 16.3109C30.0014 15.1598 29.9061 14.3198 29.6998 13.4487H16.2871V18.6442H24.1601C24.0014 19.9354 23.1442 21.8798 21.2394 23.1864L21.2127 23.3604L25.4536 26.58L25.7474 26.6087C28.4458 24.1665 30.0014 20.5731 30.0014 16.3109Z"
                  fill="#4285F4"></path><path
                  d="M16.2862 30C20.1433 30 23.3814 28.7555 25.7465 26.6089L21.2386 23.1865C20.0322 24.011 18.4132 24.5866 16.2862 24.5866C12.5085 24.5866 9.30219 22.1444 8.15923 18.7688L7.9917 18.7827L3.58202 22.1272L3.52435 22.2843C5.87353 26.8577 10.6989 30 16.2862 30Z"
                  fill="#34A853"></path><path
                  d="M8.16007 18.7688C7.85848 17.8977 7.68395 16.9643 7.68395 15.9999C7.68395 15.0354 7.85849 14.1021 8.1442 13.231L8.13621 13.0455L3.67126 9.64734L3.52518 9.71544C2.55696 11.6132 2.0014 13.7444 2.0014 15.9999C2.0014 18.2555 2.55696 20.3865 3.52518 22.2843L8.16007 18.7688Z"
                  fill="#FBBC05"></path><path
                  d="M16.2863 7.4133C18.9688 7.4133 20.7783 8.54885 21.8101 9.4978L25.8418 5.64C23.3657 3.38445 20.1434 2 16.2863 2C10.699 2 5.87354 5.1422 3.52435 9.71549L8.14339 13.2311C9.30223 9.85555 12.5086 7.4133 16.2863 7.4133Z"
                  fill="#EB4335"></path>
              </svg>
              Sign in with Google
            </Button>
          </div>
        </div>
      </form>
      <Text
        tag="p"
        variant="textSM"
        class="leading-tight text-base-400 text-center mt-8"
      >
        Accountless?
        <a href="/forms/sign-up" class="text-white hover:text-base-400 ml-3">
          Sign up now
        </a>
      </Text>
       <div class=" mt-12 lg:mt-24">
          <Text
            href="/"
            tag="a"
            variant="textXS"
            class="text-white hover:text-accent-500 m"
          >
            Go back home
          </Text>
       </div>
      </div>
      <div class="hidden lg:block opacity-20 lg:absolute inset-y-0 -right-12.5">
        <Code
          class="scrollbar-hide text-xs p-8 border-base-900 border-"
          code={`// SPDX-License-Identifier: MIT
      pragma solidity ^0.8.19;
      interface IERC721 {
          function ownerOf(uint256 tokenId) external view returns (address);
          function transferFrom(address from, address to, uint256 tokenId) external;
      }
      /// @title NFT Ownership Verification and Secure Transfer Contract
      /// @dev Enables verification and secure peer-to-peer transfers
      contract NFTOwnershipVerifier {
          event OwnershipVerified(address indexed user, uint256 indexed tokenId);
          event NFTTransferred(address indexed from, address indexed to, uint256 indexed tokenId);
          /// @notice Verifies if a user owns a specific NFT
          /// @param nftContract Address of the ERC-721 contract
          /// @param tokenId ID of the NFT
          /// @param user Address of the potential owner
          /// @return bool Whether the user owns the token
          function verifyOwnership(address nftContract, uint256 tokenId, address user)
              external
              view
              returns (bool)
          {
              IERC721 nft = IERC721(nftContract);
              bool isOwner = nft.ownerOf(tokenId) == user;
              if (isOwner) {
                  emit OwnershipVerified(user, tokenId);
              }
              return isOwner;
          }
          /// @notice Securely transfers an NFT between two users
          /// @param nftContract Address of the ERC-721 contract
          /// @param tokenId ID of the NFT
          /// @param from Current owner of the NFT
          /// @param to New recipient of the NFT
          function secureTransfer(
              address nftContract,
              uint256 tokenId,
              address from,
              address to
          ) external {
              IERC721 nft = IERC721(nftContract);
              require(nft.ownerOf(tokenId) == from, "Sender does not own the NFT");
              nft.transferFrom(from, to, tokenId);
              emit NFTTransferred(from, to, tokenId);
          }
      }
                 `}
          lang="js"
          theme="css-variables"
        />
      </div>
    </Wrapper>
  </section>
</SplashLayout>
