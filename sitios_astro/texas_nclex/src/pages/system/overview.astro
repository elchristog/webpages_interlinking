---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data array
const pageData = [
  {
    sectionTitle: "All pages",
    categories: [
      {
        title: "Main",
        links: [
          { name: "Index One", url: "/" },
          { name: "Index Two", url: "/index-two" },
          { name: "Status", url: "/helpcenter/status" },
          { name: "404", url: "/404" },
        ],
      },
      {
        title: "Pricing",
        links: [
          { name: "Pricing One", url: "/pricing/1" },
          { name: "Pricing Two", url: "/pricing/2" },
          { name: "All pricing sections", url: "/components/all-pricing" },
        ],
      },
      {
        title: "Forms",
        links: [
          { name: "Asesoría", url: "/forms/sign-in" },
          { name: "Sign up", url: "/forms/sign-up" },
          { name: "Contact", url: "/forms/contact" },
        ],
      },
      {
        title: "System Pages",
        links: [
          { name: "Links", url: "/system/link" },
          { name: "Colors", url: "/system/colors" },
          { name: "Buttons", url: "/system/buttons" },
          { name: "Typography", url: "/system/typography" },
          {
            name: "License",
            url: "https://lexingtonthemes.com/legal/license/",
          },
          {
            name: "Documentation",
            url: "https://lexingtonthemes.com/documentation",
          },
        ],
      },
    ],
  },
  {
    sectionTitle: "Content collections",
    categories: [
      {
        title: "White Paper",
        links: [
          { name: "Introduction", url: "/whitepaper/introduction" },
        
        ],
      },
      {
        title: "Blog Pages",
        links: [
          { name: "Home", url: "/blog" },
          { name: "Details", url: "/blog/posts/1" },
          { name: "Tag index", url: "/blog/tags" },
          { name: "Tag Category", url: "/blog/tags/web3" },
          { name: "RSS", url: "/rss.xml" },
        ],
      },
      {
        title: "Legal",
        links: [{ name: "Details", url: "/legal/dpa" }],
      },
      {
        title: "Help Center",
        links: [
          { name: "Knowledge Base", url: "/helpcenter/knowledge-base" },
          { name: "Home", url: "/helpcenter" },
          { name: "Details", url: "/helpcenter/1" },
        ],
      },
      {
        title: "Integrations",
        links: [
          { name: "Home", url: "/integrations" },
          { name: "Details", url: "/integrations/1" },
        ],
      },
      {
        title: "Changelog",
        links: [
          { name: "Home", url: "/changelog" },
          { name: "Details", url: "/changelog/1" },
        ],
      },
      {
        title: "Jobs",
        links: [
          { name: "Home", url: "/jobs" },
          { name: "Details", url: "/jobs/1" },
        ],
      },
      {
        title: "Customers",
        links: [
          { name: " Home", url: "/customers" },
          { name: " Details", url: "/customers/1" },
        ],
      },
      {
        title: "Teams",
        links: [
          { name: "Home", url: "/team" },
          { name: "Details", url: "/team/1" },
        ],
      },
    ],
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24">
      <Text
        tag="h1"
        variant="displayXL"
        class="mt-12 text-white text-balance font-display"
      >
        Inicio
      </Text>
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 mt-12">
        {
          pageData.map((section) => (
            <div class="md:col-span-2">
              <Text tag="p" variant="textBase" class=" text-white">
                {section.sectionTitle}
              </Text>
              <div class=" grid grid-cols-1 md:grid-cols-2 gap-y-8    mt-4 pt-4 border-t border-base-900">
                {section.categories.map((category) => (
                  <div class="flex flex-col space-y-2">
                    <Text tag="h3" variant="textBase" class=" text-white">
                      {category.title}
                    </Text>
                    {category.links.map((link) => (
                      <Text
                        tag="a"
                        variant="textSM"
                        class="text-base-500 hover:text-white"
                        href={link.url}
                        title={link.name}
                        aria-label={link.name}
                      >
                        {link.name}
                      </Text>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
