---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components

import HelpCenterCard from "@/components/helpcenter/HelpCenterCard.astro";
//  Get all help center content
import { getCollection } from "astro:content";
const allHelpCenterCard = await getCollection("helpcenter");
---

<BaseLayout>
  <section class="bg-gradient-up">
    <Wrapper
      variant="standard"
      class="py-42 relative grid grid-cols-1 sm:grid-cols-2 gap-y-12 md:grid-cols-4"
    >
      <div class="md:col-span-2">
        <Text tag="span" variant="textSM" class="text-white">
          Help center
        </Text>
        <Text
          tag="h1"
          variant="displayMD"
          class="mt-12 text-white text-balance font-display"
        >
          Web3 Support Hub
          <span class="text-base-400 block">
            Decentralized Assistance, On-Demand</span
          >
        </Text>
        <Text tag="p" variant="textBase" class="text-white mt-2 text-balance">
          Get the answers you need to navigate the decentralized web. Explore
          guides, troubleshoot smart contracts, and connect with the community.
        </Text>
       
      </div>
      <ul
        role="list"
        class="divide-y divide-base-900 text-white border-y border-base-900 lg:row-start-2 lg:col-span-2"
      >
        {allHelpCenterCard.map((post) => <HelpCenterCard post={post} />)}
      </ul>
    </Wrapper>
  </section>
</BaseLayout>
