---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data array
const helpCenterContent = [
  {
    title: "Decentralized Support Hub",
    description:
      "Navigate the Web3 space with ease. Access self-help guides, smart contract troubleshooting, and blockchain best practices.",
    linkText: "Explore Resources",
    linkHref: "/helpcenter",
  },
  {
    title: "Your Web3 Requests",
    description:
      "Track the status of your blockchain-related support tickets and get real-time updates.",
    linkText: "View All Requests",
    linkHref: "/helpcenter/status",
  },
  {
    title: "Connect with Our DAO Support",
    description:
      "Get direct assistance from our decentralized support team or reach out to the Web3 community.",
    linkText: "Contact Support",
    linkHref: "/forms/contact",
  },
];
---

<BaseLayout>
  <section class="bg-gradient-up">
    <Wrapper
      variant="standard"
      class="py-42 grid grid-cols-1 md:grid-cols-4 gap-y-12"
    >
      <div class="md:col-span-2">
        <Text tag="span" variant="textSM" class="text-white">
          Knowledge base
        </Text>
        <Text
          tag="h1"
          variant="displayXL"
          class="mt-12 text-white text-balance font-display"
        >
          Web3 Knowledge Hub
          <span class="text-base-400 block"> Learn, Build, Innovate</span>
        </Text>
        <Text tag="p" variant="textBase" class="text-white mt-2 text-balance">
          Explore in-depth guides, technical docs, and community insights to
          navigate the decentralized web with confidence.
        </Text>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-3 md:row-start-2 md:col-span-3">
        {
          helpCenterContent.map((item) => (
            <li class="before:bg-white h-full">
              <div class="px-4 relative flex flex-col h-full justify-between before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px">
                <div>
                  <Text tag="h3" variant="textBase" class="text-white">
                    {item.title}
                  </Text>
                  <Text tag="p" variant="textSM" class="mt-2 text-base-400">
                    {item.description}
                  </Text>
                </div>
                <div class="mt-12 flex">
                  <Button
                    isLink
                    size="sm"
                    variant="muted"
                    href={item.linkHref}
                    title={item.title}
                    class="w-auto justify-center"
                  >
                    {item.linkText}
                  </Button>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </Wrapper>
  </section>
</BaseLayout>
