---
// Components
import LogoCloud2 from "@/components/testimonials/LogoCloud2.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Define the pricing plans
const pricingPlans = [
  {
    title: "Explorer",
    price: "$0",
    description: "Perfect for crypto enthusiasts.",
    benefits: [
      "Deploy up to 10 smart contracts",
      "Access to public blockchain data",
      "1 wallet integration",
    ],
    isPopular: false,
    buttonVariant: "muted",
  },
  {
    title: "Builder",
    price: "$1,999/month",
    description: "50% off for the first 3 projects!",
    benefits: [
      "Deploy 50 smart contracts",
      "Connect up to two dApps",
      "Token gated content access",
      "10 API calls per second",
      "Multi-wallet support",
    ],
    isPopular: true,
    buttonVariant: "default",
  },
  {
    title: "Enterprise",
    price: "Custom",
    description: "For large-scale Web3 applications.",
    benefits: [
      "Deploy unlimited smart contracts",
      "Unlimited dApp integrations",
      "Advanced tokenomics management",
      "High-speed blockchain indexing",
      "Unlimited multi-signature wallets",
    ],
    isPopular: false,
    buttonVariant: "muted",
  },
  {
    title: "Decentralized",
    price: "Contact us",
    description: "The ultimate package.",
    benefits: [
      "Unlimited smart contract deployments",
      "Unlimited dApp integrations",
      "Customizable governance systems",
      "Decentralized storage solutions",
      "Real-time blockchain analytics",
    ],
    isPopular: false,
    buttonVariant: "accent",
  },
];
---
<section>
  <Wrapper class="py-24 grid grid-cols-1 gap-y-12 lg:gap-y-24 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Text tag="span" variant="textSM" class="text-white"> Pricing </Text>
      <Text
        tag="h2"
        variant="displayXL"
        class="tracking-tight mt-6 text-white lg:text-balance font-display"
      >
        Easy pricing. <span class="text-base-400 block"
          >No gas wars required.</span
        >
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-white lg:text-balance">
        Access all the decentralized tools you need—without breaking the bank
        (or your crypto stash).
      </Text>
    </div>
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 lg:col-span-full"
    >
      {
        pricingPlans.map((plan) => (
          <section class="flex flex-col lg:pr-8  before:bg-white lg:order-none relative">
            <div class="relative px-4   before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px">
              <div class="gap-12 w-full">
                <div>
                  <Text tag="h3" variant="textLG" class="text-white">
                    {plan.title}
                    {plan.isPopular && (
                      <span class="font-medium inline-flex items-center bg-base-900  ml-4 px-3 py-1 rounded-full text-white text-xs">
                        Popular AF!
                      </span>
                    )}
                  </Text>
                  <Text
                    tag="p"
                    variant="displayMD"
                    class="mt-16 text-white font-display  "
                  >
                    {plan.price}
                    <span class="text-sm text-base-400 font-sans ">/month</span>
                  </Text>
                  <Text tag="p" variant="textSM" class="mt-3  text-white">
                    {plan.description}
                  </Text>
                </div>
              </div>
              <div class="inline-flex flex-wrap items-center mt-8 w-full">
                <Button
                  type="button"
                  size="base"
                  variant={plan.buttonVariant}
                  class="w-full justify-center"
                >
                  Iniciar Proceso
                </Button>
              </div>
              <ul
                role="list"
                class={`flex flex-col gap-4 order-last text-sm mt-10 ${plan.isPopular ? "text-white" : "text-base-500"} `}
              >
                {plan.benefits.map((benefit) => (
                  <li class="inline-flex items-center">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="icon icon-tabler icon-tabler-check"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M5 12l5 5l10 -10" />
                    </svg>
                    <span class="ml-4">{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
    <LogoCloud2 class="row-start-3 col-span-full" />
  </Wrapper>
</section>
