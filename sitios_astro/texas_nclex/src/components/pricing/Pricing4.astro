              </td>
            </tr>
            <tr>
              <th
                scope="row"
                class="py-4 text-base font-normal leading-6 text-base-400"
              >
                Team members
                <div class="absolute inset-x-8 mt-4 h-px bg-wbony/50"></div>
              </th>
              <td class="px-6 py-4 xl:px-8">
                <svg
                  class="mx-auto text-white"
