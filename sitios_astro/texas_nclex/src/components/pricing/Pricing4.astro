---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper class="py-24 grid grid-cols-1 gap-y-12 lg:grid-cols-4">
    <div class="col-span-2">
      <Text tag="span" variant="textSM" class="text-white"> Pricing </Text>
      <Text
        tag="h2"
        variant="displayXL"
        class="tracking-tight mt-6 text-white lg:text-balance font-display"
      >
        Easy pricing. <span class="text-base-400 block"
          >No gas wars required.</span
        >
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-white lg:text-balance">
        Access all the decentralized tools you need—without breaking the bank
        (or your crypto stash).
      </Text>
    </div>

    <div class="isolate hidden lg:block col-span-full">
      <div class="relative">
        <table class="w-full table-fixed text-left">
          <caption class="sr-only"> Pricing plan comparison</caption>
          <colgroup>
            <col class="w-1/4" />
            <col class="w-1/4" />
            <col class="w-1/4" />
            <col class="w-1/4" />
          </colgroup>
          <thead>
            <tr>
              <td></td>
              <th scope="col" class="lg:order-none relative">
                <div
                  class="relative px-4 before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px"
                >
                  <Text tag="h3" variant="textLG" class="text-white font-light"
                    >Basic</Text
                  >
                </div>
              </th>
              <th scope="col" class="lg:order-none relative">
                <div
                  class="relative px-4 before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px"
                >
                  <Text tag="h3" variant="textLG" class="text-white font-light"
                    >Essential</Text
                  >
                </div>
              </th>
              <th scope="col" class="lg:order-none relative">
                <div
                  class="relative px-4 before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px"
                >
                  <Text tag="h3" variant="textLG" class="text-white font-light"
                    >Premium</Text
                  >
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row"><span class="sr-only">Price</span></th>
              <td class="px-4">
                <Text
                  tag="p"
                  variant="displayXL"
                  class="mt-16 text-white font-display"
                  >$29
                  <span class="text-sm text-base-400 font-sans">/month</span>
                </Text>
                <Text tag="p" variant="textBase" class="mt-3 text-white">
                  50% off for the first 3 projects!
                </Text>

                <Button
                  type="button"
                  size="sm"
                  variant="muted"
                  class="w-full justify-center mt-8"
                >
                  Iniciar Proceso
                </Button>
              </td>
              <td class="px-4">
                <Text
                  tag="p"
                  variant="displayXL"
                  class="mt-16 text-white font-display"
                  >$99
                  <span class="text-sm text-base-400 font-sans">/month</span>
                </Text>
                <Text tag="p" variant="textBase" class="mt-3 text-white">
                  For large-scale Web3 applications.
                </Text>

                <Button
                  type="button"
                  size="sm"
                  variant="default"
                  class="w-full justify-center mt-8"
                >
                  Iniciar Proceso
                </Button>
              </td>
              <td class="px-4">
                <Text
                  tag="p"
                  variant="displayXL"
                  class="mt-16 text-white font-display"
                  >$199
                  <span class="text-sm text-base-400 font-sans">/month</span>
                </Text>
                <Text tag="p" variant="textBase" class="mt-3 text-white">
                  For large-scale Web3 applications.
                </Text>

                <Button
                  type="button"
                  size="sm"
                  variant="accent"
                  class="w-full justify-center mt-8"
                >
                  Iniciar Proceso
                </Button>
              </td>
            </tr>
            <tr>
              <th
                scope="colgroup"
                colspan="4"
                class="py-4 text-white text-lg font-medium"
              >
                Features
              </th>
            </tr>
            <tr>
              <th
                scope="row"
                class="py-4 text-base font-normal leading-6 text-base-400"
              >
                Data Integrations
                <div class="absolute inset-x-8 mt-4 h-px bg-wbony/50"></div>
              </th>
              <td class="px-6 py-4 xl:px-8">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="icon icon-tabler icon-tabler-check text-white mx-auto"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M5 12l5 5l10 -10"></path>
                </svg>
                <span class="sr-only">Included in Basic</span>
              </td>
              <td class="px-6 py-4 xl:px-8">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="icon icon-tabler icon-tabler-check text-white mx-auto"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M5 12l5 5l10 -10"></path>
