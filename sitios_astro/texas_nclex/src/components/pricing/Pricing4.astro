              <td class="px-6 py-4 xl:px-8">
                <svg
                  class="mx-auto text-white"
                  width="16"
                  height="16"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
