                    clip-rule="evenodd"></path>
                </svg>
                <span class="sr-only">Not included in Basic</span>
              </td>
              <td class="px-6 py-4 xl:px-8">
                <div class="text-center text-sm leading-6 text-white">
                  Up to 20 users
                </div>
              </td>
              <td class="px-6 py-4 xl:px-8">
                <div class="text-center text-sm leading-6 text-white">
                  Up to 50 users
                </div>
              </td>
            </tr>

            <tr>
              <th
                scope="colgroup"
                colspan="4"
                class="py-4 text-white text-lg font-medium"
              >
                Reporting
              </th>
            </tr>

            <tr>
              <th
                scope="row"
                class="py-4 text-base font-normal leading-6 text-base-400"
