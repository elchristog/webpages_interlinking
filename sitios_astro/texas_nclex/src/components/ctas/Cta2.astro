---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="bg-gradient-down grid grid-cols-1 gap-y-12 md:grid-cols-4 pb-12">
      <div class="lg:col-span-2 lg:col-start-2 text-center">
        <Text tag="span" variant="textSM" class="text-base-400">
          Iniciar Proceso</Text
        >
        <Text
          tag="h2"
          variant="displayXL"
          class="mt-12 text-white lg:text-balance font-display"
        >
          Eager to become a partner?
        </Text>
        <Text
          tag="p"
          variant="textLG"
          class="mt-4 text-base-400 lg:text-pretty"
        >
          Sign up here. Our team will promptly get in touch with you,
          providing an enablement pack tailored to your specific requirements.
        </Text>
      </div>
      <form class="lg:col-span-2 lg:col-start-2">
        <div class="flex flex-col gap-y-4">
          <div class="grid grid-cols-1 gap-y-4 md:grid-cols-2">
            <div class="flex flex-col-reverse relative">
              <input
                type="text"
                id="first_name"
                name="first_name"
                placeholder="First name..."
                autocomplete="given-name"
                required
                class="peer relative placeholder:duration-500 placeholder:absolute focus:placeholder:pt-10 tblock w-full px-3 py-3 border-l border-l-white border-transparent appearance-none text-white bg-base-900 focus:border-white focus:bg-base-950 focus:outline-none duration-300 focus:ring-white sm:text-sm h-14 borde-white focus:placeholder:text-transparent z-10"
              />
              <label
                for="first_name"
                class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-red-500 after:content-['*'] z-0"
                >First name</label
              >
            </div>
            <div class="flex flex-col-reverse relative">
              <input
                type="text"
                id="last_name"
                name="last_name"
                placeholder="Last name..."
                autocomplete="family-name"
                required
                class="peer relative placeholder:duration-500 placeholder:absolute focus:placeholder:pt-10 tblock w-full px-3 py-3 border-l border-l-white border-transparent appearance-none text-white bg-base-900 focus:border-white focus:bg-base-950 focus:outline-none duration-300 focus:ring-white sm:text-sm h-14 borde-white focus:placeholder:text-transparent z-10"
              />
              <label
                for="last_name"
                class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-red-500 after:content-['*'] z-0"
                >Last name</label
              >
            </div>
          </div>
          <div class="flex flex-col-reverse relative">
            <input
              type="text"
              id="company"
              name="company"
              placeholder="Your Company..."
              class="peer relative placeholder:duration-500 placeholder:absolute focus:placeholder:pt-10 tblock w-full px-3 py-3 border-l border-l-white border-transparent appearance-none text-white bg-base-900 focus:border-white focus:bg-base-950 focus:outline-none duration-300 focus:ring-white sm:text-sm h-14 borde-white focus:placeholder:text-transparent z-10"
            />
            <label
              for="company"
              class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-red-500 after:content-['*'] z-0"
              >Company</label
            >
          </div>
          <div class="flex flex-col-reverse relative">
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Your Email..."
              class="peer relative placeholder:duration-500 placeholder:absolute focus:placeholder:pt-10 tblock w-full px-3 py-3 border-l border-l-white border-transparent appearance-none text-white bg-base-900 focus:border-white focus:bg-base-950 focus:outline-none duration-300 focus:ring-white sm:text-sm h-14 borde-white focus:placeholder:text-transparent z-10"
            />
            <label
              for="email"
              class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-red-500 after:content-['*'] z-0"
              >Email</label
            >
          </div>
          <div class="flex flex-col-reverse relative">
            <select
              id="country"
              name="country"
              class="peer relative block w-full px-3 py-3 border-l border-l-white border-transparent appearance-none text-white bg-base-900 focus:border-white focus:bg-base-950 focus:outline-none duration-300 focus:ring-white sm:text-sm h-14 foucs:border-white z-10"
            >
              <option value="" disabled selected>Selecciona tu país de origen</option>
              <option value="US">United States</option>
              <option value="CA">Canada</option>
              <option value="UK">United Kingdom</option>
              <option value="AU">Australia</option>
              <option value="DE">Germany</option>
              <!-- Add more countries as needed -->
            </select>
            <label
              for="country"
              class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-red-500 after:content-['*'] z-0"
              >Country</label
            >
          </div>

          <div class="flex flex-col-reverse relative">
            <textarea
              id="comments"
              name="comments"
              placeholder="Your Comments..."
              rows="4"
              class="peer relative placeholder:duration-500 placeholder:absolute focus:placeholder:pt-10 block w-full px-3 py-3 border-l border-l-white border-transparent appearance-none text-white bg-base-900 focus:border-white focus:bg-base-950 focus:outline-none duration-300 focus:ring-white sm:text-sm focus:placeholder:text-transparent resize-vertical"
              aria-describedby="comments-desc"></textarea>
            <label
              for="comments"
              class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-red-500 after:content-['*'] z-0"
              >Comments (optional)</label
            >
          </div>
          <Button
            size="base"
            variant="default"
            type="Button"
            class="w-auto justify-center"
          >
            Submit
          </Button>
        </div>
      </form>
      
    </div>
  </Wrapper>
</section>
