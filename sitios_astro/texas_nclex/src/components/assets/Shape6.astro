---
// Shape6 This component renders a component and accepts props for customization.
// Props: - class: A string of additional classes to style the component.
// - ...rest: Any other valid attributes for an div element (e.g., id, style, role, aria-label, etc.).
// Example Usage: <Shape6 class="my-custom-class" /> or <Shape6 id="Shape6-id" style="width: 50px; height: 50px;" />
const { class: className = "", ...rest } = Astro.props;
---

<div class={className} {...rest} class="bg-gradient-down">
  <svg
    class="scale-150"
    viewBox="0 0 400 400"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Rotating squares -->
    <g class="squares">
      <rect x="200" y="200" width="50" height="50" stroke="#fafafa" fill="none" class="square"></rect>
    </g>

    <!-- Pulsing circles -->
    <g class="circles">
      <circle cx="200" cy="200" r="50" stroke="#fafafa" fill="none" class="circle"></circle>
      <circle cx="200" cy="200" r="75" stroke="#444444" fill="none" class="circle"></circle>
    </g>

    <!-- Rotating hexagon -->
    <g class="hexagons">
      <polygon points="200,100 250,150 250,200 200,250 150,200 150,150" stroke="#777777" fill="none" class="hexagon"></polygon>
    </g>
  </svg>
</div>

<style>
  /* Rotating square animation */
  .square {
    transform-origin: 200px 200px; /* Sets the rotation pivot point at (200px, 200px) */
    animation: rotate 18s linear infinite; /* Rotates continuously over 18 seconds */
    opacity: 0.5; /* Makes the shape slightly transparent */
  }

  /* Pulsing circle animation */
  .circle {
    stroke-width: 0.5; /* Sets the stroke width of the circle */
    animation: pulse 30s ease-in-out infinite; /* Scales the circle in and out over 30 seconds */
    opacity: 0.6; /* Makes the shape slightly transparent */
  }

  /* Rotating hexagon animation */
  .hexagon {
    transform-origin: 200px 200px; /* Sets the rotation pivot point at (200px, 200px) */
    animation: rotate 25s linear infinite; /* Rotates continuously over 25 seconds */
    opacity: 0.4; /* Makes the shape more transparent than the others */
  }

  /* Defines the continuous rotation animation */
  @keyframes rotate {
    from {
      transform: rotate(0deg); /* Starts at 0 degrees */
    }
    to {
      transform: rotate(360deg); /* Completes a full rotation */
    }
  }

  /* Defines the pulsing effect */
  @keyframes pulse {
    0%, 100% {
      transform: scale(0.9); /* Shrinks slightly */
      opacity: 0.3; /* Reduces visibility */
    }
    50% {
      transform: scale(1.1); /* Expands slightly */
      opacity: 0.7; /* Increases visibility */
    }
  }
</style>
