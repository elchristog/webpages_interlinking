<!--
// This blur div it's at the bottom of every page.
//  Find it on the BaseLayout.astro file
--- -->
<div class="fixed inset-x-0 bottom-0 isolate z-10 h-[30px]">
    <div
      style="-webkit-backdrop-filter:blur(1px);backdrop-filter:blur(1px)"
      class="absolute inset-0 gradient-mask blur-[1px]"
    >
    </div><div
      style="-webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px)"
      class="absolute inset-0 gradient-mask blur-[2px]"
    >
    </div><div
      style="-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)"
      class="absolute inset-0 gradient-mask blur-[3px]"
    >
    </div><div
      style="-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)"
      class="absolute inset-0 gradient-mask blur-[6px]"
    >
    </div><div
      style="-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)"
      class="absolute inset-0 gradient-mask blur-[12px]"
    >
    </div>
  </div>
  