        </div>
        {
          links.map((section) => (
            <div class="before:bg-white">
              <div class="px-4 relative  before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px">
                <Text tag="h3" variant="textBase" class="text-white ">
                  {section.title}
                </Text>
                <nav role="navigation" class="mt-4">
                  <ul role="list" class=" space-y-2">
                    {section.links.map((link) => (
                      <li>
                        <Text
                          tag="a"
                          variant="textSM"
                          title={`link to ${link.label}`}
                          aria-label={link.label}
                          href={link.href}
                          class="hover:text-white"
                        >
                          {link.label}
                        </Text>
                      </li>
                    ))}
