---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Images
import { Image } from "astro:assets";
// import the logos
const avatar1 = "/imagenes_proyecto/gu-a-t-ctica-para-pasar-el-nclex-tr-mites-cgfns-y-requisitos-del-board-of-nursing-en-texas-9.webp";
const avatar2 = "/imagenes_proyecto/gu-a-t-ctica-para-pasar-el-nclex-tr-mites-cgfns-y-requisitos-del-board-of-nursing-en-texas-10.webp";
const avatar3 = "/imagenes_proyecto/gu-a-t-ctica-para-pasar-el-nclex-tr-mites-cgfns-y-requisitos-del-board-of-nursing-en-texas-11.webp";
const avatar4 = "/imagenes_proyecto/gu-a-t-ctica-para-pasar-el-nclex-tr-mites-cgfns-y-requisitos-del-board-of-nursing-en-texas-12.webp";


const testimonials = [
  {
    name: "David Gutierrez",
    role: "Web3 Creator & NFT Artist",
    imageUrl: avatar1,
    content:
      "I couldn't be happier with the seamless integration. Nuestro Equipo de Consultores went above and beyond to ensure my smart contracts were optimized and secure.",
  },
  {
    name: "Pierluigi Camomillo",
    role: "Founder of Camomille DeFi",
    imageUrl: avatar2,
    content:
      "Their expertise in DeFi solutions is unmatched. The level of transparency and efficiency they bring to on-chain transactions is game-changing.",
  },
  {
    name: "Ella Svensson",
    role: "DAO Contributor & Blockchain Advocate",
    imageUrl: avatar3,
    content:
      "The decentralization-first approach made all the difference. Finally, a team that truly understands the power of Web3!",
  },
  {
    name: "Alexa Rios",
    role: "Chief Innovator at Ideatech Labs",
    imageUrl: avatar4,
    content:
      "The personalized support and deep technical expertise helped our dApp scale effortlessly. Highly recommended for any Web3 startup!",
  },
];
---

<section>
  <Wrapper variant="standard" class="pb-32 pt-12">
    <div>
      <Text tag="span" variant="textSM" class="text-white"
        >Respaldado por Cientas de Enfermeras</Text
      >
      <Text
        tag="h3"
        variant="displayLG"
        class="mt-12 text-white text-balance font-display"
      >
        Empowering innovators, <span class="block text-base-400"
          >shaping el futuro</span
        >
      </Text>
    </div>
    <div class="grid grid-cols-1 gap-y-24 lg:grid-cols-4 mt-12">
      {
        testimonials.map((testimonial) => (
          <div class=" flex flex-col">
            <div class="relative flex  flex-col gap-4 pb-6">
              <div class="before:bg-white">
                <div class="px-4 relative  before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px">
                  <img
                    width={500}
                    height={500}
                    alt={testimonial.name}
                    src={testimonial.imageUrl}
                    class="object-cover w-full aspect-square  shrink-0 "
                  />
                </div>
              </div>
              <div >
                <Text tag="p" variant="textSM" class=" font-medium  text-white">
                  {testimonial.name}
                </Text>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-sm text-base-500 font-light "
                >
                  {testimonial.role}
                </Text>
              </div>
            </div>
            <blockquote class="relative mt-2 lg:pr-4">
              <p class="text-sm text-white">"{testimonial.content}"</p>
            </blockquote>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
