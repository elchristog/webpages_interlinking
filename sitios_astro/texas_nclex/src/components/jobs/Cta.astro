---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div
      class="bg-gradient-down text-center p-8 lg:pt-20 pb-12 border-base-900 border-x relative overflow-hidden"
    >
      <div class="relative">
        <Text
          tag="h2"
          variant="displayLG"
          class="text-white lg:text-balance font-display"
        >
          Build el futuro of Web3
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-white lg:text-balance max-w-xl mx-auto"
        >
          Join a team of innovators shaping the decentralized world. Work on
          cutting-edge blockchain technology, smart contracts, and trustless
          systems that empower the next generation of the internet.
        </Text>

        <div class="mt-10 flex items-center justify-center gap-2">
          <Button
            isLink
            size="sm"
            variant="default"
            href="/jobs"
            title="#_"
            aria-label="#_"
            class="w-auto"
          >
            Apply today
          </Button>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
