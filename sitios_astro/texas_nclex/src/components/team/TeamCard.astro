---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
const { name, role, avatar, url } = {
  url: "/team/" + Astro.props.post.id,
  role: Astro.props.post.data.role,
  avatar: Astro.props.post.data.avatar.url,
  name: Astro.props.post.data.name,
};
---

<a href={url} title={name}>
  <div class="before:bg-white">
    <div
      class="px-4 relative flex flex-col h-full justify-between before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px"
    >
      <Image
        width={500}
        height={500}
        src={avatar}
        alt={name}
        class="aspect-8/8 w-full object-top object-cover"
      />
      <Text tag="h3" variant="textBase" class="text-white mt-4">{name}</Text>
      <Text tag="p" variant="textSM" class="mt-2 text-base-400">
        {role}
      </Text>
    </div>
  </div>
</a>
