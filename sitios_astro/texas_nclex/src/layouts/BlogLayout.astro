---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "./BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Suscribirse from "@/components/blog/Suscribirse.astro";

// Frontmatter
const { frontmatter } = Astro.props;
---

<BaseLayout>
  <section >
    <Wrapper variant="standard" class="grid grid-cols-1 py-42 lg:grid-cols-4">
      <div class="lg:col-span-2 lg:col-start-2">
        <div class="flex gap-2 items-wrap">
          {
            frontmatter.tags.map((tag) => (
              <Text
                tag="a"
                variant="textSM"
                class="w-auto text-white capitalize hover:text-base-400"
                href={`/blog/tags/${tag}`}
              >
                {tag}
              </Text>
            ))
          }
        </div>
        <Text
          tag="h1"
          variant="display2XL"
          class="mt-12 text-white text-balance font-display"
        >
          {frontmatter.title}
        </Text>
        <Text tag="p" variant="textBase" class="mt-2 text-white text-balance">
          {frontmatter.description}
        </Text>
        <div class="before:bg-white">
          <div
            class="px-4 relative before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px"
          >
            <Image
              width={500}
              height={500}
              src={frontmatter.image.url}
              alt={frontmatter.image.alt}
              class="object-cover object-top w-full mt-8 aspect-16/9"
            />
          </div>
        </div>
        <Text class="mt-3 text-sm font-medium text-white">
          By {frontmatter.author} on
          <time
            datetime={new Date(frontmatter.pubDate).toLocaleDateString(
              "en-US",
              {
                year: "numeric",
                month: "long",
                day: "2-digit",
              }
            )}
          >
            {
              new Date(frontmatter.pubDate).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "2-digit",
              })
            }</time
          >
        </Text>
      </div>
      <Wrapper
        variant="prose"
        class="mt-12 lg:row-start-2 lg:col-span-2 lg:col-start-2"
        ><slot /></Wrapper
      >
    </Wrapper>
  </section>
  <Suscribirse />
</BaseLayout>
