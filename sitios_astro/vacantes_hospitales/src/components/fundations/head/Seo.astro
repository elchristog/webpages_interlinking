---
import { AstroSeo } from "@lexingtonthemes/seo";
const { 
  title = "Enfermera en Estados Unidos - Guía Oficial", 
  description = "Guía completa y oficial para trabajar como enfermera en Estados Unidos con patrocinio de visa." 
} = Astro.props;
---

<AstroSeo
  title={title}
  description={description}
  openGraph={{
    title: title,
    description: description,
    images: [
      {
        url: "/imagenes_proyecto/logo.webp",
        width: 1200,
        height: 630,
        alt: title,
        type: "image/webp",
      },
    ],
    site_name: title,
    type: "website",
    locale: "es_ES",
  }}
/>
<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
