---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const data = [
  {
    title: "Enfermeras Graduadas y Licenciadas",
    subtitle:
      "Ideal para profesionales que desean convalidar sus estudios universitarios ante el Board de Enfermería.",
  },
  {
    title: "Estudiantes de Último Año de Enfermería",
    subtitle:
      "Comienza a preparar tus documentos y la preparación del NCLEX-RN antes de tu graduación.",
  },
  {
    title: "Enfermeras Especialistas y Quirúrgicas",
    subtitle:
      "Accede a contratos en Unidades de Cuidados Intensivos (UCI), Quirófanos y Emergencias.",
  },
  {
    title: "Profesionales buscando Visa EB-3",
    subtitle:
      "Obtén la Residencia Permanente (Green Card) con patrocinio directo de hospitales norteamericanos.",
  },
  {
    title: "Asesoría Integral Paso a Paso",
    subtitle: "Te acompañamos desde la evaluación de credenciales CGFNS hasta tu entrevista consular.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-12">
    <Text tag="h2" variant="textBase" class="font-medium text-primary">
      ¿Para quién es esta guía y programa?
    </Text>

    <Text
      tag="p"
      variant="textBase"
      class="font-serif text-primary/60 text-balance"
    >
      Diseñado para enfermeras graduadas y licenciados en enfermería de Latinoamérica que buscan homologar su título y conseguir su visa de residencia permanente EB-3 en Estados Unidos.
    </Text>

    <div
      class="pt-2 mt-2 border-t border-dotted grid gap-8 md:grid-cols-2 border-primary/10 text-balance"
    >
      {
        data.map((item) => (
          <div>
            <Text tag="h3" variant="textSM" class="text-primary">
              {item.title}
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="mt-1 font-serif text-primary/60"
            >
              {item.subtitle}
            </Text>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
