---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const cards = [
  {
    title: "Evaluación Inicial Gratuita",
    subtitle:
      "Analizamos tus títulos universitarios y experiencia clínica para cumplir con el State Board.",
  },
  {
    title: "Preparación NCLEX-RN Adaptativa",
    subtitle:
      "Simuladores NGN en vivo y tutorías especializadas para asegurar tu aprobación.",
  },
  {
    title: "Tramitación de Visa EB-3",
    subtitle:
      "Gestión directa de residencia permanente para ti y tu núcleo familiar.",
  },
  {
    title: "Contrato Directo con Hospitales",
    subtitle:
      "Ubicación laboral directa en centros médicos líderes en Estados Unidos.",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-12">
    <Text tag="h2" variant="textBase" class="font-medium text-primary">
      Programas Diseñados para Tu Éxito Profesional
    </Text>

    <div
      class="pt-2 mt-2 border-t border-dotted grid gap-8 md:grid-cols-2 border-primary/10 text-balance"
    >
      {
        cards.map((card) => (
          <div>
            <Text tag="h3" variant="textSM" class="text-primary">
              {card.title}
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="mt-1 font-serif text-primary/60"
            >
              {card.subtitle}
            </Text>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
