---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const data = [
  {
    title: "Homologación Directa de Título",
    subtitle:
      "Evaluación oficial de tus asignaturas universitarias para obtener la equivalencia BSN (Bachelor of Science in Nursing).",
  },
  {
    title: "Simuladores NCLEX-RN NGN",
    subtitle:
      "Acceso a preguntas conceptuales y casos clínicos bajo el estándar de evaluación oficial de la NCSBN.",
  },
  {
    title: "Licencia RN Permanente",
    subtitle:
      "Tramitamos tu Authorization to Test (ATT) y la emisión de tu licencia como Registered Nurse.",
  },
  {
    title: "Oferta Laboral Acreditada",
    subtitle:
      "Contrato laboral directo a tiempo completo en hospitales y clínicas de Estados Unidos.",
  },
  {
    title: "Residencia Permanente EB-3",
    subtitle:
      "Trámite legal completo para tu Green Card y la de tu familia (cónyuge e hijos).",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-12">
    <Text tag="h2" variant="textBase" class="font-medium text-primary">
      Lo que Obtendrás con Nuestro Programa
    </Text>

    <Text
      tag="p"
      variant="textBase"
      class="font-serif text-primary/60 text-balance"
    >
      Un plan paso a paso con acompañamiento experto, preparación para el examen NCLEX-RN y patrocinio de visa laboral EB-3.
    </Text>

    <div
      class="pt-2 mt-2 border-t border-dotted grid gap-8 md:grid-cols-2 border-primary/10 text-balance"
    >
      {
        data.map((item) => (
          <div>
            <Text tag="h3" variant="textSM" class="text-primary">
              {item.title}
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="mt-1 font-serif text-primary/60"
            >
              {item.subtitle}
            </Text>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
