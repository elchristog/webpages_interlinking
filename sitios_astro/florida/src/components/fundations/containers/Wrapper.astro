---
interface Props {
  variant?: "standard" | "prose"; // Define any variants you need
  class?: string; // Optional prop for additional classes
  id?: string; // Optional prop for ID
}
const { variant = "standard", class: extraClass = "" } = Astro.props;
// Map each variant to its specific classes
const variantClasses = {
  // All purpose wrapper
  standard: "max-w-2xl 2xl:max-w-4xl mx-auto px-8 w-full",

  // Wrapper for prose blocks
  prose:
    "prose prose-xs max-w-3xl pt-0 mx-auto font-serif text-primary/70 prose-headings:font-sans prose-headings:text-primary prose-headings:text-base prose-a:text-accent hover:prose-a:text-accent/80 prose-p:text-primary/70 prose-li:text-primary/70 prose-ol:text-primary/70 prose-ul:text-primary/70 prose-code:text-primary prose-strong:text-primary text-sm",
};
// Combine the classes for the specified variant with any extra classes
const classes = `${variantClasses[variant]} ${extraClass}`.trim();
---

<div class={classes}>
  <slot />
</div>
