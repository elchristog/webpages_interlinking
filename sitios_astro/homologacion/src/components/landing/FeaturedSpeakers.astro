---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// speakers
import SpeakerCard from "@/components/speakers/SpeakerCard.astro";
import { getCollection } from "astro:content";
const speakers = await getCollection("speakers");
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="grid grid-cols-1 gap-y-8 lg:grid-cols-12">
      <Text
        tag="p"
        variant="textXS"
        class="uppercase text-base-600 lg:col-span-3 w-full"
      >
        Behind the programme
      </Text>
      <div class="lg:col-span-6 lg:-mt-4">
        <Text
          tag="h2"
          variant="displayXL"
          class="font-display uppercase leading-tight text-accent-500"
        >
          Featured Speakers
        </Text>
        <Text tag="p" variant="textSM" class="text-base-600 text-balance">
          Explorers of systems, typography, and interaction. This spotlight
          rotates ahead of the event—meet the minds guiding each day of Swiss
          Design Week.
        </Text>
      </div>
      <div class="flex flex-col gap-2 lg:col-start-12">
        <Button href="/speakers" size="sm" variant="outline" class="w-fit">
          All speakers
        </Button>
        <Text tag="p" variant="textXS" class="text-base-500"
          >Featured cohort • {speakers.length} total speakers</Text
        >
      </div>
    </div>
    <div
      class="grid sm:grid-cols-2 xl:grid-cols-4 mt-8 border-y border-dashed border-white/5"
    >
      {speakers.slice(0, 4).map((speaker) => <SpeakerCard speaker={speaker} />)}
    </div>
  </Wrapper>
</section>
