---
// Assets
import { Image } from "astro:assets";
// import the logos
const logo1 = "/imagenes_proyecto/logo.webp";
const logo2 = "/imagenes_proyecto/logo.webp";
const logo3 = "/imagenes_proyecto/logo.webp";
const logo4 = "/imagenes_proyecto/logo.webp";
const logo5 = "/imagenes_proyecto/logo.webp";
const logo6 = "/imagenes_proyecto/logo.webp";
const logos = [
  { src: logo1, alt: "b1 Logo" },
  { src: logo2, alt: "b2 Logo" },
  { src: logo3, alt: "b3 Logo" },
  { src: logo4, alt: "b4 Logo" },
  { src: logo5, alt: "b5 Logo" },
  { src: logo6, alt: "b6 Logo" },
];
---

<div
  class="relative mx-auto mt-12 overflow-hidden overflow-x-hidden pb-12 lg:ml-8"
>
  <div
    class="items-center relative animate-marquee flex gap-4 whitespace-nowrap"
  >
    {
      logos.map((logo) => (
        <img
          width={200}
          height={100}
          class="h-8 dark:filter-none filter invert"
          src={logo.src}
          alt={logo.alt}
        />
      ))
    }
  </div>
</div>
