---
// Assets
import { Image } from "astro:assets";
const logo1 = "/imagenes_proyecto/logo.webp";
const logo2 = "/imagenes_proyecto/logo.webp";
const logo3 = "/imagenes_proyecto/logo.webp";
const logo4 = "/imagenes_proyecto/logo.webp";
const logo5 = "/imagenes_proyecto/logo.webp";
const logo6 = "/imagenes_proyecto/logo.webp";
const logo7 = "/imagenes_proyecto/logo.webp";
const logo8 = "/imagenes_proyecto/logo.webp";
const logo9 = "/imagenes_proyecto/logo.webp";
const logo10 = "/imagenes_proyecto/logo.webp";
const logo11 = "/imagenes_proyecto/logo.webp";
const logo12 = "/imagenes_proyecto/logo.webp";
const logo13 = "/imagenes_proyecto/logo.webp";
const logo14 = "/imagenes_proyecto/logo.webp";
const logo15 = "/imagenes_proyecto/logo.webp";
const logo16 = "/imagenes_proyecto/logo.webp";
const logo17 = "/imagenes_proyecto/logo.webp";
const logo18 = "/imagenes_proyecto/logo.webp";
const logo19 = "/imagenes_proyecto/logo.webp";
const logo20 = "/imagenes_proyecto/logo.webp";
const logos = [
  { src: logo1, alt: "b1 Logo" },
  { src: logo2, alt: "b2 Logo" },
  { src: logo3, alt: "b3 Logo" },
  { src: logo4, alt: "b4 Logo" },
  { src: logo5, alt: "b5 Logo" },
  { src: logo6, alt: "b6 Logo" },
  { src: logo7, alt: "b7 Logo" },
  { src: logo8, alt: "b8 Logo" },
  { src: logo9, alt: "b9 Logo" },
  { src: logo10, alt: "b10 Logo" },
  { src: logo11, alt: "b11 Logo" },
  { src: logo12, alt: "b12 Logo" },
  { src: logo13, alt: "b13 Logo" },
  { src: logo14, alt: "b14 Logo" },
  { src: logo15, alt: "b15 Logo" },
  { src: logo16, alt: "b16 Logo" },
  { src: logo17, alt: "b17 Logo" },
  { src: logo18, alt: "b18 Logo" },
  { src: logo19, alt: "b19 Logo" },
  { src: logo20, alt: "b20 Logo" },
];
---
<div
  class="grid grid-cols-5 gap-1"
>
  {
    logos.map((logo) => (
      <img
        width={200}
        height={100}
        src={logo.src}
        alt={logo.alt}
        loading="eager"
        decoding="async"
        class="p-6 bg-white rounded aspect-square size-full"
      />
    ))
  }
</div>
