---
// Sections
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/landing/Hero.astro";
import LogoCloud1 from "@/components/global/LogoCloud1.astro";
import Services from "@/components/landing/Services.astro";
import Awwards from "@/components/global/Awwards.astro";
import Work from "@/components/landing/Work.astro";
import Why from "@/components/landing/Why.astro";
import Testimonials from "@/components/landing/Testimonials.astro";
import CtaHire from "@/components/ctas/CtaHire.astro";
import BlogPreview from "@/components/landing/BlogPreview.astro";

const paginas = Object.values(import.meta.glob('../content/*.md', { eager: true }));
const indexContent: any = paginas.find((p: any) => p.frontmatter?.slug === 'index' || p.file?.endsWith('index.md'));
---
<BaseLayout title={indexContent?.frontmatter?.titulo} description={indexContent?.frontmatter?.descripcion}>
  {
    indexContent ? (
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <indexContent.Content />
      </main>
    ) : (
      <>

  <Hero />
  <LogoCloud1 />
  <Services />
  <Awwards />
  <Work />
  <Why />
  <Testimonials />
  <CtaHire />
  <BlogPreview />

      </>
    )
  }
</BaseLayout>
