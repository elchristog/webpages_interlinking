---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Sections
import Hero from "@/components/landing/Hero.astro";
import Hiring from "@/components/landing/Hiring.astro";
import Companies from "@/components/landing/Companies.astro";
import Categories from "@/components/landing/Categories.astro";
import Candidates from "@/components/landing/Candidates.astro";
import FeaturedJobs from "@/components/landing/FeaturedJobs.astro";

const paginas = Object.values(import.meta.glob('../content/*.md', { eager: true }));
const indexContent: any = paginas.find((p: any) => p.frontmatter?.slug === 'index' || p.file?.endsWith('index.md'));
---

<BaseLayout title={indexContent?.frontmatter?.titulo} description={indexContent?.frontmatter?.descripcion}>
  {
    indexContent ? (
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <indexContent.Content />
      </main>
    ) : (
      <>

  <section>
    <Wrapper variant="standard" class="py-24">
      <Hero />
      <div class="mt-12 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
        <FeaturedJobs />
        <Categories />
        <div class="space-y-12">
          <Hiring />
          <Companies />
        </div>
        <Candidates />
      </div>
    </Wrapper>
  </section>

      </>
    )
  }
</BaseLayout>
