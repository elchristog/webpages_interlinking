---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Icons
import Code from "@/components/fundations/icons/Code.astro";
import Brain from "@/components/fundations/icons/Brain.astro";
import Report from "@/components/fundations/icons/Report.astro";
import Stacked from "@/components/fundations/icons/Stacked.astro";
import Persist from "@/components/fundations/icons/Persist.astro";
import Filters from "@/components/fundations/icons/Filters.astro";
import Settings from "@/components/fundations/icons/Settings.astro";
import WaveSquare from "@/components/fundations/icons/WaveSquare.astro";

const features = [
  {
    id: "test-mode",
    title: "Evaluación de Credenciales CGFNS",
    description:
      "Validamos tus materias universitarias e intensidad horaria clínica para garantizar la elegibilidad ante el Board of Nursing.",
    icon: Brain,
  },
  {
    id: "webhooks",
    title: "Simulador Adaptativo NCLEX-RN",
    description:
      "Plataforma de estudio con bancos de preguntas NGN tipo examen real para asegurar tu aprobación en el primer intento.",
    icon: WaveSquare,
  },
  {
    id: "logs",
    title: "Gestión de Visa EB-3 y Residencia",
    description:
      "Acompañamiento legal completo para la petición I-140 y obtención de Green Card para ti y tu familia.",
    icon: Report,
  },
  {
    id: "retries",
    title: "Ubicación Hospitalaria Directa",
    description:
      "Conexión con redes de hospitales y ofertas laborales con excelentes salarios y beneficios en EE. UU.",
    icon: Persist,
  },
  {
    id: "tracking",
    title: "Monitoreo del Proceso de Convalidación",
    description:
      "Seguimiento activo del estado de tus documentos ante agencias de verificación y departamentos de salud.",
    icon: Filters,
  },
  {
    id: "templating",
    title: "Preparación de Exámenes de Inglés (TOEFL / IELTS)",
    description:
      "Cursos enfocados en alcanzar el puntaje requerido para la certificación de enfermería internacional.",
    icon: Code,
  },
  {
    id: "previews",
    title: "Asesoría Legal y Contractual",
    description:
      "Revisión minuciosa de contratos de trabajo y beneficios de relocalización ofreciendo seguridad jurídica.",
    icon: Stacked,
  },
  {
    id: "domains",
    title: "Orientación en Destino y Licencia Estatal",
    description:
      "Orientación paso a paso para la emisión final de tu licencia RN y radicación exitosa en EE. UU.",
    icon: Settings,
  },
];
---

<section>
  <Wrapper variant="standard" class="pt-12 pb-4 border-t">
    <div class="max-w-xl text-balance">
      <Text
        tag="h2"
        variant="displaySM"
        class="font-serif font-medium tracking-tight text-black"
      >
        Creado por especialistas para acompañar tu homologación
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-base-500">
        Diseñamos un sistema integral para resolver cada etapa del proceso: desde la convalidación de credenciales CGFNS hasta tu vinculación laboral.
      </Text>
    </div>
    <div
      class="items-center mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2"
    >
      {
        features.map((feature) => {
          const Icon = feature.icon;
          return (
            <div class="flex flex-col h-full p-4 bg-sand-100 rounded-xl group hover:bg-white hover:shadow-2xl duration-300 outline-transparent hover:outline hover:outline-sand-100 ">
              <div class="inline-flex p-4 bg-white rounded-lg group-hover:bg-sand-100 duration-300 group-hover:-rotate-12 group-hover:-translate-y-2 w-fit">
                <Icon size="base" class=" text-accent-500" />
              </div>
              <Text
                tag="h3"
                variant="textSM"
                class="mt-12 font-medium text-base-900"
              >
                {feature.title}
              </Text>
              <Text tag="p" variant="textSM" class="mt-2 text-base-500">
                {feature.description}
              </Text>
            </div>
          );
        })
      }
    </div>
  </Wrapper>
</section>
