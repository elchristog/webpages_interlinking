---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Icons
import Code from "@/components/fundations/icons/Code.astro";
import Brain from "@/components/fundations/icons/Brain.astro";
import Report from "@/components/fundations/icons/Report.astro";
import Stacked from "@/components/fundations/icons/Stacked.astro";
import Persist from "@/components/fundations/icons/Persist.astro";
import Filters from "@/components/fundations/icons/Filters.astro";
import Settings from "@/components/fundations/icons/Settings.astro";
import WaveSquare from "@/components/fundations/icons/WaveSquare.astro";

const features = [
  {
    id: "homologacion",
    title: "Homologación Directa",
    description:
      "Evaluamos tus credenciales universitarias (CGFNS/WES) para garantizar el cumplimiento de requisitos del Board de Enfermería.",
    icon: Brain,
  },
  {
    id: "nclex",
    title: "Preparación NCLEX-RN",
    description:
      "Clases en vivo, simuladores reales de examen y banco de preguntas preparatorias con más de 3,000 casos clínicos.",
    icon: WaveSquare,
  },
  {
    id: "visa",
    title: "Patrocinio Visa EB-3",
    description:
      "Tramitación de Green Card (Residencia Permanente en EE. UU.) para ti, tu cónyuge e hijos menores de 21 años.",
    icon: Report,
  },
  {
    id: "contratos",
    title: "Contratos Hospitalarios",
    description:
      "Ofertas laborales directas con sistemas de salud acreditados en Florida, Texas, California, Georgia y más estados.",
    icon: Persist,
  },
  {
    id: "salarios",
    title: "Salarios Competitivos",
    description:
      "Ingresos promedio desde $75,000 hasta $110,000 USD anuales según tu especialidad y estado de ubicación.",
    icon: Filters,
  },
  {
    id: "reubicacion",
    title: "Bono de Reubicación",
    description:
      "Asistencia económica para tiquetes aéreos, alojamiento inicial y apoyo en trámites de llegada.",
    icon: Code,
  },
  {
    id: "ingles",
    title: "Inglés Clínico Especializado",
    description:
      "Entrenamiento intensivo en vocabulario médico para superar con éxito las pruebas TOEFL iBT o IELTS Academic.",
    icon: Stacked,
  },
  {
    id: "acompanamiento",
    title: "Acompañamiento VIP 1 a 1",
    description:
      "Asesoría personalizada en cada fase del proceso hasta tu incorporación formal al equipo hospitalario.",
    icon: Settings,
  },
];
---

<section>
  <Wrapper variant="standard" class="pt-12 pb-4 border-t">
    <div class="max-w-xl text-balance">
      <Text
        tag="h2"
        variant="displaySM"
        class="font-serif font-medium tracking-tight text-black"
      >
        Ventajas Exclusivas de Nuestro Programa de Reclutamiento
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-base-500">
        Diseñamos un proceso transparente e integral, respaldado por expertos en inmigración y docentes especializados en enfermería internacional.
      </Text>
    </div>
    <div
      class="items-center mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2"
    >
      {
        features.map((feature) => {
          const Icon = feature.icon;
          return (
            <div class="flex flex-col h-full p-4 bg-sand-100 rounded-xl group hover:bg-white hover:shadow-2xl duration-300 outline-transparent hover:outline hover:outline-sand-100 ">
              <div class="inline-flex p-4 bg-white rounded-lg group-hover:bg-sand-100 duration-300 group-hover:-rotate-12 group-hover:-translate-y-2 w-fit">
                <Icon size="base" class=" text-accent-500" />
              </div>
              <Text
                tag="h3"
                variant="textSM"
                class="mt-12 font-medium text-base-900"
              >
                {feature.title}
              </Text>
              <Text tag="p" variant="textSM" class="mt-2 text-base-500">
                {feature.description}
              </Text>
            </div>
          );
        })
      }
    </div>
  </Wrapper>
</section>
