---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import List from "@/components/fundations/icons/List.astro";
import Analytics from "@/components/fundations/icons/Analytics.astro";
import UsersGroup from "@/components/fundations/icons/UsersGroup.astro";
---

<section>
  <Wrapper variant="standard" class="flex flex-col py-12 border-t gap-24">
    <div class="items-start grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="flex flex-col justify-between h-full text-balance gap-4">
        <div class="inline-flex p-4 rounded-lg bg-sand-100 w-fit">
          <List size="base" class="text-accent-600" />
        </div>
        <div>
          <Text
            tag="h2"
            variant="displaySM"
            class="font-serif font-medium tracking-tight text-black"
          >
            Gestión Consular y Patrocinio de Visa EB-3
          </Text>
          <Text tag="p" variant="textBase" class="max-w-xl mt-4 text-base-500">
            Un equipo legal de inmigración radicado en Estados Unidos gestiona tu petición I-140 y el trámite de visa de residencia permanente (Green Card) para ti y tu núcleo familiar.
          </Text>
          <div class="flex mt-4">
            <Button isLink size="sm" variant="accent" href="/blog">Ver Guías de Inmigración</Button>
          </div>
        </div>
      </div>
      <div
        aria-hidden="true"
        class="p-8 pb-0 pr-0 overflow-hidden bg-sand-100 rounded-xl group"
      >
        <div
          class="max-w-md p-4 mx-auto -mb-1 -mr-1 bg-white rounded-tl-xl shadow-sm outline outline-sand-500/10"
        >
          <div class="flex items-center gap-4">
            <div
              class="inline-flex p-4 rounded-lg bg-sand-100 duration-300 group-hover:-rotate-12 group-hover:-translate-y-2"
            >
              <UsersGroup size="sm" />
            </div>
            <div>
              <p class="text-sm text-base-500">Red de Reclutamiento</p>
              <p class="text-base font-medium text-base-900">
                Enfermeras Colocadas en EE. UU.
              </p>
            </div>
          </div>
          <div
            class="pt-4 mt-4 border-t grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 border-base-100 gap-y-8"
          >
            <div>
              <p class="text-sm text-base-500">Enfermeras Activas</p>
              <p class="text-base font-medium text-base-900">+500</p>
            </div>
            <div>
              <p class="text-sm text-base-500">Tasa Aprobación NCLEX</p>
              <p class="text-base font-medium text-base-900">96.8%</p>
            </div>
            <div>
              <p class="text-sm text-base-500">Salario Promedio</p>
              <p class="text-base font-medium text-base-900">$85,000/año</p>
            </div>
            <div>
              <p class="text-sm text-base-500">Hospitales Aliados</p>
              <p class="text-base font-medium text-base-900">+45</p>
            </div>
            <div>
              <p class="text-sm text-base-500">Estados de Destino</p>
              <p class="text-base font-medium text-base-900">12 Estados</p>
            </div>
            <div>
              <p class="text-sm text-base-500">Tiempo de Proceso</p>
              <p class="text-base font-medium text-base-900">14-18 Meses</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="items-center grid grid-cols-1 md:grid-cols-2 gap-12">
      <div
        class="flex flex-col justify-between h-full text-balance gap-4 lg:order-last"
      >
        <div class="inline-flex p-4 rounded-lg bg-sand-100 w-fit">
          <Analytics size="base" class="text-accent-600" />
        </div>
        <div>
          <Text
            tag="h2"
            variant="displaySM"
            class="font-serif font-medium tracking-tight text-black"
          >
            Preparación de Examen NCLEX-RN con Métodos Garantizados
          </Text>
          <Text tag="p" variant="textBase" class="max-w-xl mt-4 text-base-500">
            Nuestros docentes capacitados en universidades de Estados Unidos te guían con simuladores reales NGN (Next Generation NCLEX) para aprobar en tu primer intento.
          </Text>
          <div class="flex mt-4">
            <Button isLink size="sm" variant="accent" href="/blog">Conocer el Método</Button>
          </div>
        </div>
      </div>
      <div
        aria-hidden="true"
        class="p-8 pb-0 pl-0 overflow-hidden bg-sand-100 rounded-xl group"
      >
        <div class="flex flex-col gap-4">
          <div
            class="p-6 bg-white shadow rounded-r-xl outline outline-sand-500/10"
          >
            <p class="text-sm text-base-500">Aprobación NCLEX-RN</p>
            <p class="mt-2 text-4xl font-medium text-base-900">96.8%</p>
            <div class="mt-6 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span
                    class="size-3 rounded-full group-hover:-translate-x-2 duration-300 bg-[#5aab69]"
                  ></span>
                  <span class="text-sm text-base-600">Aprobados 1er Intento</span>
                </div>
                <span class="text-sm font-medium text-base-900">3,204</span>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span
                    class="size-3 rounded-full group-hover:-translate-x-2 duration-300 bg-[#e3962d]"
                  ></span>
                  <span class="text-sm text-base-600">En Preparación</span>
                </div>
                <span class="text-sm font-medium text-base-900">180</span>
              </div>
            </div>
          </div>
          <div
            class="p-6 -mb-1 bg-white shadow rounded-tr-xl outline outline-sand-500/10"
          >
            <p class="text-sm text-base-500">Colocación Hospitalaria</p>
            <p class="mt-2 text-4xl font-medium text-base-900">98%</p>
            <div class="mt-6 space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span
                    class="size-3 rounded-full group-hover:-translate-x-2 duration-300 bg-[#60beff]"
                  ></span>
                  <span class="text-sm text-base-600">Contratos Firmados</span>
                </div>
                <span class="text-sm font-medium text-base-900">1,350</span>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span
                    class="size-3 rounded-full group-hover:-translate-x-2 duration-300 bg-[#e3962d]"
                  ></span>
                  <span class="text-sm text-base-600">Entrevistas Activas</span>
                </div>
                <span class="text-sm font-medium text-base-900">472</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
