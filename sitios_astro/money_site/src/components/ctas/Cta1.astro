---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<section class="border-t border-base-200 border-dashed">
  <Wrapper variant="standard" class="py-4 lg:border-x lg:border-base-200">
    <div class="p-8 py-24 text-center rounded-xl bg-accent-500">
      <div class="text-balance">
        <Text
          tag="h2"
          variant="displayLG"
          class="font-serif font-medium text-white"
        >
          Tu Futuro como Enfermera en EE. UU. Empieza Hoy
        </Text>
        <Text tag="p" variant="textLG" class="mt-2 text-white/80">
          Evaluamos tu perfil profesional sin costo y trazamos la ruta directa para tu homologación, preparación NCLEX y contrato laboral.
        </Text>
      </div>
      <div class="flex justify-center mt-8">
        <Button isLink gap="sm" size="base" variant="muted" href="https://api.whatsapp.com/send?phone=TU_NUMERO_DE_WHATSAPP&text=Hola%2C%20quiero%20m%C3%A1s%20informaci%C3%B3n">
          Solicitar Evaluación Gratuita
        </Button>
      </div>
    </div>
  </Wrapper>
</section>
