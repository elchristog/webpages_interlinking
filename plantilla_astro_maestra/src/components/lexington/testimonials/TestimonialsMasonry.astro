---
interface TestimonialItem {
  name: string;
  location: string;
  quote: string;
  imageUrl: string;
  linkText?: string;
  linkUrl?: string;
}

interface Props {
  title?: string;
  highlightText?: string;
  subtitle?: string;
  testimonials?: TestimonialItem[];
}

const {
  title = "Historias de Éxito Reales",
  highlightText = "Vidas Transformadas en USA",
  subtitle = "Cientos de profesionales han confiado en nuestro programa para cumplir su sueño.",
  testimonials = []
} = Astro.props;
---

<section class="ui-lifestyle-grid py-20 md:py-28 bg-[#0a0a0a] text-white overflow-hidden" id="historias-exito">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white m-0 text-center leading-tight mb-4">
      {title} <br /><span class="bg-gradient-to-r from-orange-400 to-amber-500 bg-clip-text text-transparent">{highlightText}</span>
    </h2>
    <p class="text-lg md:text-xl text-gray-300 text-center max-w-3xl mx-auto mb-16 opacity-90">
      {subtitle}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map(item => (
        <div class="bg-[#18181b] rounded-[2.5rem] p-8 border border-white/10 shadow-2xl flex flex-col justify-between transition-all duration-500 hover:-translate-y-2 hover:border-white/20">
          <div>
            <div class="flex items-center gap-4 mb-6">
              <img src={item.imageUrl} alt={item.name} class="w-16 h-16 rounded-full object-cover border-2 border-white/30 shadow-md flex-shrink-0" />
              <div>
                <h3 class="text-xl font-bold text-white leading-tight">{item.name}</h3>
                <span class="text-sm text-orange-400 font-medium">{item.location}</span>
              </div>
            </div>
            <p class="text-base text-gray-300 leading-relaxed italic mb-6">
              "{item.quote}"
            </p>
          </div>
          {item.linkText && (
            <a href={item.linkUrl || "#contacto-directo"} class="text-sm font-bold text-orange-400 hover:text-orange-300 transition-colors no-underline">
              {item.linkText} →
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
