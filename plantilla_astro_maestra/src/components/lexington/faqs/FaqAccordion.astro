---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  supportLinkText?: string;
  supportLinkUrl?: string;
  faqs?: FaqItem[];
}

const {
  title = "Preguntas Frecuentes",
  description = "Hemos recopilado las dudas más comunes para brindarte claridad y confianza.",
  supportLinkText = "contactar a nuestro equipo de soporte",
  supportLinkUrl = "https://wa.me/XXXXXXXXXXX",
  faqs = []
} = Astro.props;
---

<section class="ui-faq-section py-20 md:py-28 bg-[#0a0a0a] text-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-6 leading-tight">
          {title}
        </h2>
        <p class="text-base md:text-lg text-gray-300 leading-relaxed mb-6">
          {description} Si no encuentras tu respuesta, no dudes en <a href={supportLinkUrl} class="text-orange-400 font-bold hover:underline">{supportLinkText}</a>.
        </p>
      </div>

      <div class="lg:col-span-8 space-y-6">
        {faqs.map((faq, idx) => (
          <details class="group bg-[#18181b] rounded-2xl p-6 border border-white/10 shadow-lg cursor-pointer transition-all duration-300 hover:border-white/20 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between text-lg md:text-xl font-bold text-white tracking-tight">
              <span>{faq.question}</span>
              <span class="ml-4 transition-transform duration-300 group-open:rotate-180 text-orange-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 pt-4 border-t border-white/10 text-base md:text-lg text-gray-300 leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
