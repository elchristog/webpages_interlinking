---
interface Props {
  title?: string;
  highlightText?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  trustLogos?: { name: string; url: string }[];
}

const {
  title = "Tu Futuro Comienza Ahora",
  highlightText = "Vacantes Enfermera en USA",
  subtitle = "Acompañamiento experto para homologación, NCLEX y visa de trabajo con patrocinio.",
  ctaText = "Agenda tu Sesión Estratégica",
  ctaLink = "#contacto-directo",
  trustLogos = []
} = Astro.props;
---

<section class="ui-hero-agency relative py-20 md:py-32 bg-[#0a0a0a] text-white overflow-hidden border-b border-white/10">
  <div class="max-w-6xl mx-auto px-6 text-center relative z-10">
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-tight mb-8">
      {title} <span class="bg-gradient-to-r from-orange-400 to-amber-500 bg-clip-text text-transparent">{highlightText}</span>
    </h1>
    <p class="text-lg md:text-2xl text-gray-300 max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
      {subtitle}
    </p>
    <div class="flex justify-center mb-12">
      <a href={ctaLink} class="inline-block px-10 py-5 bg-gradient-to-r from-orange-500 to-amber-600 hover:from-orange-600 hover:to-amber-700 text-white font-bold text-lg rounded-full shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
        {ctaText}
      </a>
    </div>
    {trustLogos.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16 pt-8 border-t border-white/10 opacity-80">
        {trustLogos.map(logo => (
          <img src={logo.url} alt={logo.name} class="h-8 md:h-10 object-contain" />
        ))}
      </div>
    )}
  </div>
</section>
