---
// Icons
import { ChevronRight } from "lucide-astro";
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import config from "@/data/config_inyectada.json";

// Dynamic menu from config
const menuItems = config.menu_global || [];
---

<header class="fixed z-50 w-full top-0 left-0 bg-white/80 backdrop-blur-md border-b border-base-200 shadow-sm transition-all duration-300">
  <div class="px-4 md:px-8 mx-auto max-w-7xl">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo Area -->
      <div class="flex-shrink-0 flex items-center">
        <a
          href="/"
          class="flex items-center gap-2 group transition-opacity hover:opacity-80"
          aria-label="Home"
        >
          <div class="bg-[var(--color-primary)] rounded-lg p-2 flex items-center justify-center">
            <Logo class="w-6 h-6 text-white" />
          </div>
          <span class="font-bold text-lg tracking-tight text-base-900 hidden xl:block truncate max-w-[250px]">
            {config.nombre_sitio || "Enfermera EE.UU."}
          </span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center justify-center gap-4 xl:gap-8 flex-1 px-4 overflow-hidden" aria-label="Main navigation">
        {
          menuItems.map((item) => (
            <a
              href={item.ruta}
              class="text-sm font-medium text-base-600 hover:text-[var(--color-primary)] transition-colors whitespace-nowrap"
            >
              {item.nombre}
            </a>
          ))
        }
      </nav>

      <!-- CTA & Mobile Toggle -->
      <div class="flex items-center gap-4 flex-shrink-0">
        <div class="hidden sm:block">
          <Button
            isLink
            href="/"
            size="md"
            variant="default"
            class="bg-black text-white px-5 xl:px-6 rounded-full font-medium tracking-tight shadow-md hover:shadow-lg transition-all hover:scale-105 whitespace-nowrap"
          >
            Contactar
          </Button>
        </div>
        
        <button
          class="lg:hidden relative z-50 p-2 text-base-600 hover:text-[var(--color-primary)] focus:outline-none transition-colors rounded-md hover:bg-base-100"
          aria-label="Toggle navigation menu"
          id="navToggle"
        >
          <span class="sr-only">Toggle navigation</span>
          <svg class="w-6 h-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
            <path id="menuIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            <path id="closeIcon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="navMenu"
    class="fixed inset-0 top-[64px] z-40 hidden flex-col w-full bg-white/95 backdrop-blur-xl h-[calc(100vh-64px)] overflow-y-auto px-6 py-8 border-t border-base-200"
  >
    <div class="flex flex-col gap-6 w-full">
      {
        menuItems.map((item) => (
          <a
            href={item.ruta}
            class="text-xl font-semibold text-base-900 hover:text-[var(--color-primary)] transition-colors pb-4 border-b border-base-100 w-full"
          >
            {item.nombre}
          </a>
        ))
      }
      <div class="pt-4">
        <Button
          isLink
          href="/"
          size="lg"
          variant="default"
          class="w-full bg-[var(--color-primary)] text-white rounded-xl shadow-md text-center py-4 text-lg font-semibold"
        >
          Contactar Ahora
        </Button>
      </div>
    </div>
  </div>

  <script type="module">
    document.addEventListener("DOMContentLoaded", function () {
      const toggle = document.getElementById("navToggle");
      const nav = document.getElementById("navMenu");
      const menuIcon = document.getElementById("menuIcon");
      const closeIcon = document.getElementById("closeIcon");

      if(toggle && nav) {
        toggle.addEventListener("click", () => {
          const isHidden = nav.classList.contains("hidden");
          nav.classList.toggle("hidden", !isHidden);
          nav.classList.toggle("flex", isHidden);
          menuIcon.classList.toggle("hidden", isHidden);
          closeIcon.classList.toggle("hidden", !isHidden);
          document.body.style.overflow = isHidden ? "hidden" : "";
        });
      }

      // Auto-fix raw markdown links that AI might have injected in plain text
      const walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
      let n;
      const nodesToReplace = [];
      while ((n = walk.nextNode())) {
        if (n.nodeValue.includes("[") && n.nodeValue.includes("](")) {
          nodesToReplace.push(n);
        }
      }
      nodesToReplace.forEach(node => {
        const regex = /\[([^\]]+)\]\(([^)]+)\)/g;
        if(regex.test(node.nodeValue)) {
          const span = document.createElement('span');
          span.innerHTML = node.nodeValue.replace(regex, '<a href="$2" class="text-[var(--color-primary)] underline hover:text-[var(--color-accent)]">$1</a>');
          node.parentNode.replaceChild(span, node);
        }
      });
    });
  </script>
</header>
