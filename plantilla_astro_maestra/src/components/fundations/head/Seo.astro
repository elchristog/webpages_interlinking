---
import { AstroSeo } from "@lexingtonthemes/seo";
import config from "@/data/config_inyectada.json";

const { titulo, descripcion } = Astro.props;

const nombreSitio = config.nombre_sitio || "Enfermera en Estados Unidos";
const tituloPagina = titulo || config.titulo_sitio || `${nombreSitio} - Guía Principal y Homologación`;
const descripcionPagina = descripcion || config.descripcion_sitio || "Información completa sobre el proceso migratorio, homologación de título y licencias de enfermería en Estados Unidos.";
---

<title>{tituloPagina}</title>
<meta name="description" content={descripcionPagina} />

<AstroSeo
  title={tituloPagina}
  description={descripcionPagina}
  openGraph={{
    title: tituloPagina,
    description: descripcionPagina,
    site_name: nombreSitio,
    type: "website",
    locale: "es_ES",
  }}
  twitter={{
    cardType: "summary_large_image",
  }}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:title" content={tituloPagina} />
<meta property="og:description" content={descripcionPagina} />
<meta property="og:image" content="/imagenes_proyecto/logo.webp" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:title" content={tituloPagina} />
<meta property="twitter:description" content={descripcionPagina} />
<meta property="twitter:image" content="/imagenes_proyecto/logo.webp" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
